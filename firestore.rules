rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == profileId
        && request.resource.data.keys().hasOnly([
          'id', 'displayName', 'categorySlug', 'categoryName',
          'neighborhood', 'bio', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == profileId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.neighborhood is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 600000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == profileId
        && request.resource.data.id == profileId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.neighborhood is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 600000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'categorySlug', 'categoryName',
          'neighborhood', 'bio', 'photoURL', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow read: if resource.data.status == 'open'
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName
          == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.categorySlug is string
        && request.resource.data.categoryName is string
        && request.resource.data.neighborhood is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'categorySlug', 'categoryName',
          'neighborhood', 'ownerId', 'ownerName', 'status', 'createdAt'
        ]);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'categorySlug', 'categoryName', 'neighborhood', 'status'
        ])
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['open', 'closed', 'removed'])
          || (request.resource.data.status == resource.data.status
            && resource.data.status == 'open'
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 5
            && request.resource.data.title.size() <= 100
            && request.resource.data.description is string
            && request.resource.data.description.size() >= 10
            && request.resource.data.description.size() <= 2000
            && request.resource.data.categorySlug is string
            && request.resource.data.categoryName is string
            && request.resource.data.neighborhood is string));
      allow delete: if false;

      match /applications/{applicationId} {
        function ownsOpportunity() {
          return signedIn()
            && get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.ownerId == request.auth.uid;
        }

        allow get: if signedIn()
          && (applicationId == request.auth.uid
            || ownsOpportunity());
        allow list: if signedIn()
          && (resource.data.applicantId == request.auth.uid || ownsOpportunity());
        allow create: if signedIn()
          && applicationId == request.auth.uid
          && request.resource.data.applicantId == request.auth.uid
          && request.resource.data.applicantName
            == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
          && request.resource.data.opportunityId == opportunityId
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 10
          && request.resource.data.message.size() <= 1000
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.ownerId != request.auth.uid
          && get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.status == 'open'
          && request.resource.data.keys().hasOnly([
            'opportunityId', 'applicantId', 'applicantName', 'message', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }

    match /conversations/{conversationId} {
      function applicationAfterWrite() {
        return getAfter(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)/applications/$(request.resource.data.applicantId)).data;
      }

      allow get: if signedIn()
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow list: if signedIn()
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'opportunityId', 'opportunityTitle', 'ownerId', 'ownerName',
          'applicantId', 'applicantName', 'participantIds',
          'lastMessage', 'lastMessageAt', 'createdAt'
        ])
        && request.resource.data.opportunityId is string
        && request.resource.data.opportunityTitle is string
        && request.resource.data.ownerId
          == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.ownerId
        && (request.resource.data.applicantId == request.auth.uid
          || request.resource.data.ownerId == request.auth.uid)
        && request.resource.data.ownerName
          == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.ownerName
        && request.resource.data.applicantId is string
        && request.resource.data.applicantName
          == get(/databases/$(database)/documents/profiles/$(request.resource.data.applicantId)).data.displayName
        && request.resource.data.participantIds
          == [request.resource.data.ownerId, request.resource.data.applicantId]
        && applicationAfterWrite().applicantId == request.resource.data.applicantId
        && applicationAfterWrite().opportunityId == request.resource.data.opportunityId
        && applicationAfterWrite().applicantName == request.resource.data.applicantName
        && request.resource.data.lastMessage is string
        && applicationAfterWrite().message == request.resource.data.lastMessage
        && request.resource.data.lastMessage.size() >= 1
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.createdAt == request.time
        && (get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.status == 'open'
          || request.auth.uid == request.resource.data.ownerId);
      allow update: if signedIn()
        && resource.data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() >= 1
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastMessageAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function isConversationMigration() {
          let parentPath = /databases/$(database)/documents/conversations/$(conversationId);
          let applicationPath = /databases/$(database)/documents/opportunities/$(conversation().opportunityId)/applications/$(conversation().applicantId);
          return request.auth.uid == conversation().ownerId
            && !exists(parentPath)
            && exists(applicationPath)
            && request.resource.data.senderId == conversation().applicantId
            && request.resource.data.senderName == get(applicationPath).data.applicantName
            && request.resource.data.text == get(applicationPath).data.message
            && (request.resource.data.createdAt == get(applicationPath).data.createdAt
              || (get(applicationPath).data.createdAt == null
                && request.resource.data.createdAt == request.time));
        }

        allow read: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.participantIds.hasAny([request.auth.uid]);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && conversation().participantIds.hasAny([request.auth.uid])
          && (
            (request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderName
                == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
              && request.resource.data.createdAt == request.time)
            || isConversationMigration()
          );
        allow update, delete: if false;
      }
    }

    match /osascoPosts/{postId} {
      allow read: if resource.data.status == 'published';
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /conversationStates/{conversationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['unreadCount', 'lastReadAt'])
          && request.resource.data.unreadCount == 0
          && request.resource.data.lastReadAt == request.time;
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCount', 'lastReadAt'])
          && request.resource.data.unreadCount == 0
          && request.resource.data.lastReadAt == request.time;
        allow delete: if false;
      }

      match /processedMessages/{messageId} {
        allow read, write: if false;
      }
    }
  }
}
